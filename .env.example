LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
CHAT_MODEL=gpt-4.1-mini

# Optional: read runtime settings from a sibling Law-RAG project's .env.
LAW_RAG_ROOT=
RAG_MODE=openai

# Optional local OpenAI-compatible runtime, for example Ollama.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=local
LOCAL_CHAT_MODEL=qwen2.5:7b-instruct

YOUTUBE_API_KEY=
